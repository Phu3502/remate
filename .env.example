# Địa chỉ website thật (dùng cho sitemap, thẻ chia sẻ, SEO). Ví dụ:
NEXT_PUBLIC_SITE_URL=https://remate.vn

# Supabase → Project Settings → API (hoặc API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Khóa công khai: "anon" (eyJ...) hoặc "publishable" (sb_publishable_...) đều dùng được.
# TUYỆT ĐỐI KHÔNG dùng khóa service_role / secret ở đây.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
